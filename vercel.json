{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/p/(.*)/files/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/p/:token/manifest.json", "destination": "/data/:token/manifest.json" },
    { "source": "/p/:token/files/:file*", "destination": "/data/:token/:file*" },
    { "source": "/p/:token", "destination": "/templates/viewer.html" },
    { "source": "/admin", "destination": "/templates/admin.html" },
    { "source": "/", "destination": "/templates/index.html" }
  ]
}
